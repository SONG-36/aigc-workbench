# Example values only. Backend reads process environment, not this file.
# Relative data paths are resolved from the repository root.
AIGC_DATA_DIR=.runtime/f01
AIGC_GENERATION_MAX_WORKERS=3
AIGC_ALLOWED_ORIGINS=http://127.0.0.1:8021,http://localhost:8021
# Vite server-side proxy setting; never put credentials in VITE_* variables.
AIGC_API_TARGET=http://127.0.0.1:8022

# Local C01 developer CLI only; disabled by default.
AIGC_ENV=development
AIGC_ENABLE_C01_TESTING=0
# S03 real execution has a separate gate; offline preflight needs no credential.
AIGC_ENABLE_C01_REAL=0
# C01 CLI: existing process OPENAI_API_KEY wins, otherwise backend/.env.local (0600).
# That private file accepts only OPENAI_API_KEY= plus comments; never use VITE_*.
# CLI requires an explicit documented model, paid-call confirmation and USD budget.
# Only the official https://api.openai.com/v1/responses endpoint is supported.
