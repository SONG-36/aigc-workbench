# Example values only. Backend reads process environment, not this file.
# Relative data paths are resolved from the repository root.
AIGC_DATA_DIR=.runtime/f01
AIGC_ALLOWED_ORIGINS=http://127.0.0.1:8021,http://localhost:8021
# Vite server-side proxy setting; never put credentials in VITE_* variables.
AIGC_API_TARGET=http://127.0.0.1:8022
